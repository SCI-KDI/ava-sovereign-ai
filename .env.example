# Local evaluation only. Copy to .env, then change both secrets:
#   cp .env.example .env
#   openssl rand -hex 32    # paste the output as WEBUI_SECRET_KEY
# Never commit .env.

POSTGRES_PASSWORD=change-me
WEBUI_SECRET_KEY=change-me

# Small model pulled into Ollama on first start. It must support tool calling,
# or delegation will not work. qwen3:4b needs about 3 GB of RAM.
OLLAMA_MODEL=qwen3:4b
